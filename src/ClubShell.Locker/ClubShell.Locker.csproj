<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- позволяет собирать проект и на macOS/Linux для проверки -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>ClubShell.Locker</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2792.45" />
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
    <ProjectReference Include="..\ClubShell.Core\ClubShell.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- собранный интерфейс (ui/dist) копируется в папку ui рядом с exe -->
    <None Include="..\..\ui\dist\**\*" Link="ui\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
