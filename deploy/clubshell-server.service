# Установка: sudo cp clubshell-server.service /etc/systemd/system/ && sudo systemctl daemon-reload && sudo systemctl enable --now clubshell-server
[Unit]
Description=ClubShell club server
After=network-online.target
Wants=network-online.target
# битая база не должна крутить бесконечный цикл перезапусков
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
User=clubshell
Group=clubshell
# ключ администратора, база и копии доступны только пользователю clubshell
UMask=0077
WorkingDirectory=/opt/clubshell-server
ExecStart=/opt/clubshell-server/ClubShell.Server
Restart=always
RestartSec=2
Environment=ASPNETCORE_URLS=http://127.0.0.1:5080
Environment=Club__DataDir=/var/lib/clubshell
Environment=Club__TimeZone=Europe/Moscow
Environment=Club__SeedDemo=false
# без libicu на сервере: инвариантная культура (нам нужны только даты и числа)
Environment=DOTNET_SYSTEM_GLOBALIZATION_INVARIANT=1
# в журнал только предупреждения и ошибки: пульсы ПК идут постоянно, подробный лог забил бы диск
Environment=Logging__LogLevel__Default=Warning
Environment=Logging__LogLevel__Microsoft.AspNetCore=Warning
# Сервер слушает только localhost, наружу его выставляет nginx с HTTPS.
TimeoutStopSec=15
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/clubshell
PrivateTmp=true
ProtectHome=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
MemoryMax=1G
TasksMax=512
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
